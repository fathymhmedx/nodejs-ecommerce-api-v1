NODE_ENV=development
PORT=8000

# Database
# Replace <db_password> with your actual password
DB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<db_name>?retryWrites=true&w=majority
DB_PASS=your_database_password_here

# Client URL
CLIENT_URL=http://localhost:3000

# Base URL Image
BASE_URL=http://localhost:8000

# JWT Settings
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET_KEY=your_jwt_refresh_key_here
JWT_REFRESH_EXPIRES_IN=7d

# Email Settings (Example values for Ethereal or Gmail)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_email_user_here
EMAIL_PASSWORD=your_email_password_here
EMAIL_FROM_NAME=E-shop
EMAIL_FROM=your_email@example.com

# Stripe Settings
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET_KEY=whsec_your_webhook_secret

# Redis Settings
REDIS_URL=redis://default:password@host:port